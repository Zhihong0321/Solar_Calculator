# Database Configuration
# Do not store database credentials in this repo.
# Railway should provide DATABASE_URL and DATABASE_URL_TARIFF as environment variables.
DATABASE_URL=
DATABASE_URL_TARIFF=

# Node Environment
NODE_ENV=production

# Cloudflare R2 (SEDA registration file storage)
# Create the API token in the Cloudflare dashboard: R2 Object Storage > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Xiaomi MiMo Token Plan (receipt OCR — src/modules/ClaimReceipt)
# Two keys are round-robined so concurrent OCR calls aren't throttled by one key's rate limit.
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_API_KEY=
MIMO_API_KEY_2=
