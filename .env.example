# Database Configuration
# Do not store database credentials in this repo.
# Railway should provide DATABASE_URL and DATABASE_URL_TARIFF as environment variables.
DATABASE_URL=
DATABASE_URL_TARIFF=

# Node Environment
NODE_ENV=production

# Cloudflare R2 (SEDA registration file storage)
# Create the API token in the Cloudflare dashboard: R2 Object Storage > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Eternalgy router (receipt OCR — src/modules/ClaimReceipt). Base URL and model already default
# to these values in code; only the key has to be set.
AI_ROUTER_BASE_URL=https://e-router.up.railway.app/v1
AI_ROUTER_MODEL=gpt-5.6-luna
AI_ROUTER_API_KEY=

# Google Drive Support Ticket Video Upload (Service Account)
GOOGLE_DRIVE_FOLDER_ID=1wewcq9UiGs8WxJrvq-16qPjt-5CzzF8q
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=


# Prototype: conversational quotation at /lab/chat (isolated, URL-only)
CHAT_LAB_ENABLED=false
CHAT_LAB_MODEL=gpt-5.6-luna
CHAT_LAB_VISION_MODEL=step-3.7-flash
